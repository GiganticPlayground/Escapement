# Escapement environment variables.
#
# Uncommented lines are what a working local run needs. Everything commented out
# shows its default. Validation happens at import (src/config/env.validation.ts),
# so a bad value fails the boot rather than the first request.

# --- Server ---
PORT=3000
NODE_ENV=development
# LOG_LEVEL=debug
# LOG_TYPE=pretty            # json | pretty | hidden

# Leave unset to allow all origins. Use * to allow all explicitly.
# Example: http://localhost:3000,https://app.example.com
# CORS_ORIGINS=*

# Express trust proxy behaviour: false for direct connections, true to trust
# forwarded headers, or a number when exactly that many proxies sit in front.
# Affects req.ip, and therefore IP-based rate limiting.
# TRUST_PROXY=false

# Per-client rate limiting on all of /v1/escapement — every method, reads
# included, applied before authentication.
# RATE_LIMIT_ENABLED=false
# RATE_LIMIT_MAX=300
# RATE_LIMIT_WINDOW_MS=60000

# Max request body size, as a byte string.
# ESCAPEMENT_MAX_BODY_BYTES=16mb

# --- AWS / S3 ---
# S3 is the only database. These two become segments of every object key, so a
# stray slash or a '..' would silently relocate the log — both are validated and
# a bad value fails the boot.
AWS_REGION=us-east-1
ESCAPEMENT_S3_BUCKET=escapement-state
# Fixed per deployment; free-form. Keys become <prefix>/<env>/log/<seq>.json
ESCAPEMENT_ENV=dev
# The prefix owning Escapement's tree. Surrounding slashes and whitespace are
# normalized away and multi-level values (team-a/escapement) are allowed; an empty
# value is not, because Escapement never writes to the bucket root. When the
# bucket is shared, picking a prefix nobody else writes under is a deployment
# decision.
# ESCAPEMENT_KEY_PREFIX=escapement
# Point at MinIO or a stub for local runs. Unset uses the default AWS endpoint.
# ESCAPEMENT_S3_ENDPOINT=http://localhost:9000

# --- Engine ---
# How peers reach THIS node. Under Docker Swarm set the task name template,
# ESCAPEMENT_ENDPOINT_HOST={{.Task.Name}}, which resolves on the overlay network.
# Defaults to the container hostname.
# ESCAPEMENT_ENDPOINT_HOST=

# Group commit window. When commits are already running back to back the leader
# holds the door open this long so concurrent commands share one S3 PUT; an
# isolated claim on an idle node skips it entirely. Raising it trades latency for
# fewer, larger writes — see the coupling with PRUNE_RETAIN below.
# BATCH_WINDOW_MS=50
# MAX_BATCH=500

# Worst-case failover after a hard kill. A graceful stop releases the lease
# immediately and does not wait this out. Must exceed 2 x FOLLOW_POLL_MS.
# LEASE_TTL_MS=15000
# How often a follower tails the log and re-checks the lease.
# FOLLOW_POLL_MS=1000

# Commits between snapshots. Lower = faster recovery, more S3 writes.
# SNAPSHOT_EVERY=1000
# Log entries kept behind a snapshot instead of pruned, so a reader cannot have a
# key deleted out from under it mid-read. Must comfortably exceed the commits a
# follower can miss in one FOLLOW_POLL_MS — roughly
# FOLLOW_POLL_MS / BATCH_WINDOW_MS. The defaults leave 10x headroom.
# PRUNE_RETAIN=200

# Idempotency records kept in memory and in each snapshot, evicted oldest first.
# This is the window in which a client retry returns its original result.
# IDEMPOTENCY_LIMIT=50000

# --- JWT verification ---
# Escapement never issues tokens; it only verifies them.
#   jwt-jwks  (default) — RS256, validated against the remote JWKS at JWKS_URI
#   jwt-hs256           — HS256, validated against the shared JWT_SECRET
# JWT_AUTH_MODE=jwt-jwks
#
# Required when JWT_AUTH_MODE=jwt-jwks.
JWKS_URI=https://auth.example.com/.well-known/jwks.json
# Required when JWT_AUTH_MODE=jwt-hs256. Shared secret the issuer signs with.
# JWT_SECRET=change-me
JWT_ISSUER=https://auth.example.com
# Strongly recommended. Without it, verification checks only signature and
# issuer, so a token the same issuer minted for a DIFFERENT service is accepted
# here too. The service logs a warning per strategy that omits it.
JWT_AUDIENCE=escapement
# JWT_APP_CLAIM=app
#
# Per-path authorization. The issuer carries allowed/denied path patterns in these
# claims; this service names which claims to read. Enforcement is opt-in per
# token — a token without the claim is unaffected. Patterns match the absolute
# request path (e.g. /v1/escapement/*) unless JWT_PATH_PREFIX strips a mount
# prefix first.
# JWT_WHITELIST_CLAIM=whitelist
# JWT_BLACKLIST_CLAIM=blacklist
# JWT_PATH_PREFIX=

# Deployment config file. Declares which auth strategies the service accepts —
# several at once if needed (player JWTs plus a service token), and which of them
# may reach the admin routes. The JWT_* vars above describe a single strategy and
# are only used when there is no config file.
# Unset falls back to ./config/escapement.yaml when that file exists; pointing
# this at a file that does not exist is a startup error, not a fallback.
# A template lives at config/escapement.yaml.example.
# ESCAPEMENT_CONFIG_PATH=./config/escapement.yaml

# --- Request analytics (reqcast) ---
# Opt-in, disabled unless a config file is provided. Sinks, filters and output
# format are all defined in that file; an example lives at
# examples/reqcast.config.json.
# REQCAST_CONFIG=./examples/reqcast.config.json

# --- Shutdown ---
# Time allowed for in-flight commands to drain before the lease is released.
# DRAIN_TIMEOUT_MS=10000
# Hard ceiling on the whole shutdown sequence.
# SHUTDOWN_TIMEOUT_MS=30000

# --- API documentation ---
# Serves Swagger UI at /api-docs.
# API_DOCS_ENABLED=true
