# Escapement deployment config — auth strategies.
#
# Copy this file to config/escapement.yaml (the default location, used automatically
# when present), or point ESCAPEMENT_CONFIG_PATH at a copy of it elsewhere.
# With no file at all, Escapement builds a single strategy from the JWT_* env vars,
# which is the behavior it had before this file existed.
#
# Any value here may name where it comes from, so a secret need not be written in
# this file. Both placeholders are resolved at startup, and an unset var or an
# unreadable file stops the service from booting rather than starting half-configured:
#
#   ${env:VAR}    the environment — for orchestrators that inject secrets as vars.
#   ${file:PATH}  a file — for Docker/Kubernetes secrets, which are mounted rather
#                 than exported, so the value never enters the process environment.
#                 A trailing newline is stripped.
#   <literal>     the value itself. Fine for issuers and URLs; a secret written this
#                 way makes THIS FILE sensitive, so it stops being safe to commit.
#
# Written with placeholders, this file is safe to commit next to a deployment.

auth:
  # ---------------------------------------------------------------------------
  # Mobile players. Path rules travel in the token's own claims, so the auth
  # service decides per player what the token may reach; a token carrying neither
  # claim is unrestricted.
  # ---------------------------------------------------------------------------
  - type: jwks
    issuer: ${env:JWT_ISSUER}
    jwks_url: ${env:JWKS_URI}
    # Strongly recommended: without an audience, any token this issuer minted
    # for another service verifies here too. Omitting it logs a warning.
    audience: escapement
    paths:
      whitelistClaim: whitelist
      blacklistClaim: blacklist

  # ---------------------------------------------------------------------------
  # An internal service that mints its own HS256 tokens. `admin: true` lets it
  # reach the /v1/escapement/admin/... routes — seeding and releasing pool codes
  # and defining quotas — plus the engine status endpoint. Grant it deliberately.
  #
  # `requirements` are claim checks applied after verification: this one only
  # accepts tokens whose `scope` claim includes `escapement:admin`.
  # ---------------------------------------------------------------------------
  # - type: hs256
  #   issuer: https://internal-tools.example.com
  #   secret: ${env:INTERNAL_JWT_SECRET}
  #   appClaim: app
  #   admin: true
  #   requirements:
  #     - type: scope
  #       value: escapement:admin

  # ---------------------------------------------------------------------------
  # A shared secret for a service that cannot mint JWTs. A static token carries
  # no claims, so nothing in the request names its holder, and a strategy has to
  # say which of the two usable shapes it is — at least one of:
  #
  #   admin: true   the /v1/escapement/admin/... routes, where the target comes
  #                 from the URL. Seeding and releasing pool codes, defining
  #                 quotas, the engine status endpoint. Grant it deliberately.
  #
  #   service:      the normal routes, under an identity named HERE rather than
  #                 by the token. See the next entry.
  #
  # Inline whitelist/blacklist patterns are fixed by this file and are the only
  # way to scope a static token. Note that an inline list REPLACES the matching
  # claim for that strategy: set `whitelist` here and `whitelistClaim` is ignored.
  #
  # `token` takes any of the three sources described at the top of this file — pick
  # whichever your secret store hands you:
  #
  #   token: ${env:ESCAPEMENT_STATIC_TOKEN}          # injected as an env var
  #   token: ${file:/run/secrets/escapement-token}   # mounted as a Docker/K8s secret
  #   token: dev-only-not-for-production          # inline, local deployments only
  # ---------------------------------------------------------------------------
  # - type: static
  #   token: ${env:ESCAPEMENT_STATIC_TOKEN}
  #   admin: true
  #   paths:
  #     whitelist:
  #       - /v1/escapement/admin/*

  # ---------------------------------------------------------------------------
  # A trusted server-side caller — a backend claiming codes on behalf of players
  # it has already authenticated itself. It is not a player and has no `sub` to
  # offer, so `service` supplies the identity the token cannot: `app` and `actor`
  # are used exactly where a JWT strategy would use its app claim and `sub`.
  #
  # That identity is the point. Without it every holder of the token would share
  # the `-:anonymous` idempotency namespace with every other anonymous caller;
  # with it they get their own (`{app}:{actor}:{machine}:{key}`). It is still ONE
  # namespace for everything holding this token, so such a caller must make its
  # own keys unique — include the player and the reason for the call, not just a
  # request id. Claims are attributed to `actor` unless the request body passes
  # `by`, so pass `by` when the claim is for a player.
  #
  # `service` grants nothing on the admin routes. A caller that needs both says
  # `admin: true` as well, and gets each on purpose.
  #
  # Only one `static` strategy may be configured: a static token carries nothing
  # to tell two of them apart, so a second would silently inherit the first one's
  # privileges. Scope this one with `paths` instead.
  # ---------------------------------------------------------------------------
  # - type: static
  #   token: ${file:/run/secrets/escapement-service-token}
  #   service:
  #     app: platform
  #     actor: platform-service
  #   paths:
  #     whitelist:
  #       - GET /v1/escapement/pools/*
  #       - POST /v1/escapement/pools/*/claims
